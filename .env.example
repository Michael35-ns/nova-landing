# ============================================================
# Formulario de contacto / cotización
#
# Si NO defines nada aquí, el formulario envía a /contacto.php
# (script PHP incluido en public/, ideal para hosting cPanel/Apache).
# Solo hay que editar $TO y $FROM dentro de ese archivo.
#
# Para usar otro destino, copia este archivo a ".env" y completa UNA opción:
# ============================================================

# --- Opción A: Web3Forms (sin backend) --------------------
# Crea una "Access Key" gratis en https://web3forms.com con el correo
# donde quieres recibir los leads y pégala aquí.
VITE_WEB3FORMS_KEY=

# --- Opción B: endpoint propio ---------------------------
# URL de tu función serverless / API. Si se define, tiene prioridad.
# Ej. con /api/contact.ts desplegado en Vercel:
# VITE_CONTACT_ENDPOINT=/api/contact
VITE_CONTACT_ENDPOINT=

# --- Variables SOLO del endpoint /api/contact.ts (Vercel/Netlify) ---
# (no llevan prefijo VITE_ porque nunca deben llegar al navegador)
RESEND_API_KEY=
LEAD_FROM_EMAIL=web@novosti.com
LEAD_TO_EMAIL=proyectos@novosti.com
